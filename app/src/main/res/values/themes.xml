<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EServicesICCHelper" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary actions/buttons -->
        <item name="colorPrimary">@color/primary_dark_brown</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_accent</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark_brown</item>

        <!-- Secondary actions -->
        <item name="colorSecondary">@color/secondary_brown</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/divider_color</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <!-- Highlights/selected states -->
        <item name="colorTertiary">@color/accent_gold</item>
        <item name="colorOnTertiary">@color/text_primary</item>
        <item name="colorTertiaryContainer">@color/light_accent</item>
        <item name="colorOnTertiaryContainer">@color/text_primary</item>

        <!-- Background and Surfaces -->
        <item name="android:windowBackground">@color/background_cream</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Dividers and Borders -->
        <item name="colorOutline">@color/divider_color</item>
        <item name="colorOutlineVariant">@color/divider_color</item>

        <!-- Success, Warning, Error -->
        <item name="colorError">@color/error_color</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary_dark_brown</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.EServicesICCHelper" parent="Base.Theme.EServicesICCHelper" />
</resources>